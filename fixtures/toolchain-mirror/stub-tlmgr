#!/bin/sh
# Answers like tlmgr install: each package is looked up in the repository's catalog.txt
# ("name file…", a "bin:NAME" item creates an executable). An unknown name gets tlmgr's own
# wording, which is what paperlint parses. Every call is appended to tlmgr.log at the tree root.
bin=$(cd "$(dirname "$0")" && pwd)
tree=$(cd "$bin/../.." && pwd)
repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repository) repo=$2; shift 2 ;;
    install) shift; break ;;
    # `check depends` in tlmgr's own layout: every name in missing-deps.txt (what the stub
    # install-tl was told to drop) is a dependency without a package. Not logged: it installs nothing.
    check)
      if [ -s "$tree/missing-deps.txt" ]; then
        echo " DEPENDS WITHOUT PACKAGES:"
        sed 's/$/ in: collection-basic latex-bin/' "$tree/missing-deps.txt"
        exit 2
      fi
      exit 0 ;;
    *) shift ;;
  esac
done
echo "$repo $*" >> "$tree/tlmgr.log"
catalog="${repo#file://}/catalog.txt"
# A repository for a NEWER TeX Live than the tree: tlmgr refuses before installing anything, in
# the wording of tlmgr.pl (TeX Live 2026, lines 7644-7648). The repository's year is the file
# release-year beside catalog.txt; a mirror without one is not checked.
remote=$(cat "${repo#file://}/release-year" 2>/dev/null || true)
local=$(sed -n '1s/.*version \([0-9]\{4\}\).*/\1/p' "$tree/release-texlive.txt")
if [ -n "$remote" ] && [ "$remote" -gt "$local" ]; then
  echo "tlmgr: Local TeX Live ($local) is older than remote repository ($remote)."
  echo "Cross release updates are only supported with"
  echo "  update-tlmgr-latest(.sh/.exe) -- --upgrade"
  echo "See https://tug.org/texlive/upgrade.html for details."
  exit 1
fi
status=0
for p in "$@"; do
  line=$(grep "^$p " "$catalog" || true)
  if [ -z "$line" ]; then
    echo "tlmgr install: package $p not present in repository."
    status=1
    continue
  fi
  # Installing a dropped dependency repairs the tree.
  [ -f "$tree/missing-deps.txt" ] && sed -i "/^$p\$/d" "$tree/missing-deps.txt"
  for item in ${line#* }; do
    case "$item" in
      bin:*) : > "$bin/${item#bin:}"; chmod +x "$bin/${item#bin:}" ;;
      *) echo "$item" >> "$tree/files.txt" ;;
    esac
  done
done
exit $status
